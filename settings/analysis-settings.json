{
  "workflow": "somatic-mutations",
  "workflow_version": "1.0.0",
  "random_seed": 42,
  "genome": "hg38",
  "lab_run_time": "1 min 40 s (import of 200 tumours from the GDC: 2 min 2 s)",
  "parameters": {
    "input": {
      "genome": "hg38"
    },
    "variant_qc": {
      "min_vaf": 0,
      "min_depth": 0,
      "capture_size_mb": 38
    },
    "landscape": {
      "n_genes": 20,
      "annotate_by": null,
      "genes_of_interest": [
        "VHL",
        "PBRM1",
        "SETD2",
        "BAP1",
        "KDM5C"
      ],
      "n_interaction_genes": 25,
      "min_mutated_samples": 5
    },
    "signatures": {
      "enabled": true,
      "min_substitutions_per_sample": 50,
      "max_delta": 0.004
    },
    "comparison": {
      "enabled": true,
      "group_column": "vital_status",
      "test_level": "Dead",
      "reference_level": "Alive",
      "reference_is_everyone_else": false,
      "min_mutated_samples": 5,
      "alpha": 0.05,
      "p_adjust_method": "BH"
    },
    "copy_number": {
      "enabled": true,
      "gain_log2": 0.2,
      "loss_log2": -0.2,
      "min_markers": 10,
      "bin_mb": 2,
      "include_sex_chromosomes": false
    }
  },
  "software_versions": {
    "input": {
      "R": "4.5.2",
      "maftools": "2.24.0",
      "data.table": "1.18.6.1",
      "Bioconductor": "3.21"
    },
    "variant_qc": {
      "R": "4.5.2",
      "maftools": "2.24.0",
      "Bioconductor": "3.21"
    },
    "landscape": {
      "R": "4.5.2",
      "maftools": "2.24.0",
      "Bioconductor": "3.21"
    },
    "signatures": {
      "R": "4.5.2",
      "maftools": "2.24.0",
      "MutationalPatterns": "3.18.0",
      "BSgenome.Hsapiens.UCSC.hg38": "1.4.5",
      "Bioconductor": "3.21"
    },
    "comparison": {
      "R": "4.5.2",
      "maftools": "2.24.0",
      "Bioconductor": "3.21"
    },
    "copy_number": {
      "R": "4.5.2",
      "GenomeInfoDb": "1.44.3",
      "TxDb.Hsapiens.UCSC.hg38.knownGene": "3.21.0",
      "Bioconductor": "3.21"
    }
  }
}